        "func": "var Nome = msg.payload.Nome;\nvar area_ID = msg.payload.area_ID;\nvar ID_TipoSensor = msg.payload.ID_TipoSensor;\nvar coordenada = msg.payload.coordenada;\n\nvar ID_ValorSensor_Principal = msg.payload.ID_ValorSensor_Principal ? msg.payload.ID_ValorSensor_Principal : 'NULL';\nvar ID_ValorSensor = msg.payload.ID_ValorSensor ? msg.payload.ID_ValorSensor : 'NULL';\n\n// Gera a query SQL de atualização\nmsg.topic = `UPDATE Sensor \nSET Nome = '${Nome}', \n    area_ID = ${area_ID}, \n    ID_TipoSensor = ${ID_TipoSensor}, \n    coordenada = '${coordenada}', \n    ID_ValorSensor_Principal = ${ID_ValorSensor_Principal},\n    ID_ValorSensor = ${ID_ValorSensor}\nWHERE ID = ${msg.req.params.ID};`;\n\nreturn msg;\n",

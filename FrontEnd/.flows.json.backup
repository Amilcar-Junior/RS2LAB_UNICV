    {
        "id": "12ba2647ed5f9452",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "48649284f90446aa",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    a.ID AS Area_ID, \n    a.Nome AS Area_Nome, \n    a.Localizacao AS Area_Localizacao,\n    a.ID_Grupo AS Grupo_ID,\n    a.ID_Local AS Local_ID,\n    JSON_ARRAYAGG(\n        JSON_OBJECT(\n            'Sensor_ID', s.ID,\n            'Sensor_Nome', s.Nome,\n            'TipoSensor_ID', s.ID_TipoSensor,\n            'Sensor_Coordenada', s.coordenada,\n            'TipoSensor_Nome', t.Nome,\n            'TipoSensor_Icon', t.icon\n        )\n    ) AS Sensores\nFROM \n    AreaDeAgricultura a\nLEFT JOIN \n    Sensor s ON a.ID = s.area_ID\nLEFT JOIN \n    TipoSensor t ON s.ID_TipoSensor = t.ID\nGROUP BY \n    a.ID;\n`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1940,
        "y": 6700,
        "wires": [
            [
                "9e22caae67936910"
            ]
        ]
    },

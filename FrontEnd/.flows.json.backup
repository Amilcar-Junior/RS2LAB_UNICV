    {
        "id": "903f5e795fc79aa4",
        "type": "http in",
        "z": "b945a241e156bcfb",
        "g": "76d13409270878fb",
        "name": "Recebe Requisição do Vue.js",
        "url": "/getstudentbycode",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 1120,
        "y": 1080,
        "wires": [
            [
                "078f7ae1d190427f"
            ]
        ]
    },
    {
        "id": "078f7ae1d190427f",
        "type": "function",
        "z": "b945a241e156bcfb",
        "g": "76d13409270878fb",
        "name": "Prepare API Request",
        "func": "node.log(`Recebida requisição para /getstudentbycode: ${JSON.stringify(msg.req.query)}`);\n\n// Extrair o código da query string\nvar codigo = msg.req.query.codigo;\nif (!codigo) {\n    node.error('Código de estudante não fornecido.');\n    msg.statusCode = 400;\n    msg.payload = { error: 'Código de estudante é obrigatório.' };\n    return [null, msg];\n}\n\n// Construir a URL da API\nmsg.url = `https://betaapi.unicv.cv/api-basic-v1/person/view?id=${codigo}`;\n\n// Extrair o token do cabeçalho Authorization\nconst authHeader = msg.req.headers.authorization;\nif (!authHeader || !authHeader.startsWith('Bearer ')) {\n    node.error('Token de autenticação não fornecido ou inválido.');\n    msg.statusCode = 401;\n    msg.payload = { error: 'Token de autenticação é obrigatório.' };\n    return [null, msg];\n}\n\n// Configurar o cabeçalho Authorization para a requisição à API\nmsg.headers = {\n    'Authorization': authHeader\n};\n\nnode.log(`Enviando requisição para: ${msg.url}`);\nnode.log(`Cabeçalho Authorization: ${msg.headers.Authorization}`);\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1380,
        "y": 1080,
        "wires": [
            [
                "deadf4b9c6947e16"
            ],
            [
                "6107e7dbc5c0397b"
            ]
        ]

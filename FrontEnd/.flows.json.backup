    {
        "id": "d30c2be0a8704e5e",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "aca2614308f3370d",
        "name": "QUERY",
        "func": "msg.topic = `SELECT \n    AreaDeAgricultura.ID, \n    AreaDeAgricultura.Nome, \n    AreaDeAgricultura.Localizacao, \n    g.ID as Grupo_ID, \n    g.Nome AS Grupo_Nome,\n    l.ID as Local_ID,\n    l.Nome as Local_Nome,\n    l.lat,\n    l.lng\nFROM \n    AreaDeAgricultura\nLEFT JOIN\n    GrupoUtilizadores g ON AreaDeAgricultura.ID_Grupo = g.ID\nLEFT JOIN\n    Local l ON AreaDeAgricultura.ID_Local = l.ID\nWHERE AreaDeAgricultura.ID = ${msg.req.params.ID};`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 7200,

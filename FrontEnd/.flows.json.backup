        "g": "63d59090aac9b7e0",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT\n    g.ID AS Grupo_ID,\n    g.Nome AS Grupo_Nome,\n    JSON_ARRAYAGG(\n        JSON_OBJECT(\n            'ID', u.ID,\n            'Nome', u.Nome\n        )\n    ) AS Utilizadores\nFROM\n    GrupoUtilizadores g\nLEFT JOIN\n    UtilizadorGrupo ug ON g.ID = ug.ID_Grupo\nLEFT JOIN\n    Utilizador u ON ug.ID_Utilizador = u.ID\nGROUP BY\n    g.ID;\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 1820,
        "wires": [
            [
                "c8db7b617ed32a4a"
            ]
        ]
    },

    {
        "id": "07d33b4c622878ea",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "9d4878beb21615fa",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT\n    s.ID AS Sensor_ID,\n    s.Nome AS Sensor_Nome,\n    s.area_ID AS Area_ID,\n    s.coordenada AS Sensor_Coordenada,\n    s.ID_ValorSensor AS ValorSensor_ID,\n    t.ID AS TipoSensor_ID,\n    t.Nome AS TipoSensor_Nome,\n    t.icon AS TipoSensor_Icon,\n    JSON_OBJECT(\n        'Valor', v.Valor,\n        'Data_Hora', v.Data_Hora,\n        'Topico', v.Topico,\n        'is_activable', v.is_activatable\n    ) AS ValorSensor_Detalhes,\n    JSON_OBJECT(\n        'Valor', p.Valor,\n        'Data_Hora', p.Data_Hora,\n        'Topico', p.Topico,\n        'is_activable', p.is_activatable\n    ) AS ValorSensor_Principal_Detalhes,\n    JSON_OBJECT(\n        'Area_ID', a.ID,\n        'Area_Nome', a.Nome,\n        'Area_Localizacao', a.Localizacao\n    ) AS Area_Detalhes\nFROM\n    Sensor s\nJOIN\n    TipoSensor t ON s.ID_TipoSensor = t.ID\nLEFT JOIN\n    ValorSensor p ON s.ID_ValorSensor_Principal = p.ID\nLEFT JOIN\n    ValorSensor v ON s.ID_ValorSensor = v.ID\nLEFT JOIN\n    AreaDeAgricultura a ON s.area_ID = a.ID\nWHERE\n    t.ID = ${msg.req.params.ID}\nGROUP BY\n    s.ID, t.ID;\n`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1880,
        "y": 5940,
        "wires": [
            [
                "82752b172f82c818",
                "3517b42c0ab7f9ec"
            ]
        ]
    },

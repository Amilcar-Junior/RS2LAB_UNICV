    {
        "id": "5a6b7c8d",
        "type": "function",
        "z": "a1b2c3d4e5",
        "name": "Filtrar Dados",
        "func": "let data = msg.payload.data;\nif (msg.payload.success && data) {\n    msg.payload = {\n        name: data.name || \"Não disponível\",\n        curso: data.course || \"Não disponível\",\n        email: data.email || \"Não disponível\"\n    };\n} else {\n    msg.payload = { error: \"Estudante não encontrado\" };\n    msg.statusCode = 404;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,

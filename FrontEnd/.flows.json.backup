    {
        "id": "3ed4d89775460558",
        "type": "http in",
        "z": "b945a241e156bcfb",
        "g": "76d13409270878fb",
        "name": "Add Students",
        "url": "/biosentry/addStudents",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 1090,
        "y": 860,
        "wires": [
            [
                "9369a29f46c50c55"
            ]
        ]
    },
    {
        "id": "9369a29f46c50c55",
        "type": "function",
        "z": "b945a241e156bcfb",
        "g": "76d13409270878fb",
        "name": "Query",
        "func": "msg.payload.impressao_digital = global.get(\"finger_id\") || null;\n\n// Validação do status_ (garante que seja '0' ou '1')\nif (msg.payload.status_ !== '0' && msg.payload.status_ !== '1') {\n  msg.payload.status_ = '1'; // Valor padrão: '0' (Inativo)\n}\n\n// Query segura com prepared statement\nmsg.topic = `\n  INSERT INTO pessoa \n    (nome, codigo, email, curso, status, id_dispositivo, impressao_digital, id_perfil) \n  VALUES (?, ?, ?, ?, ?, ?, ?, ?)`;\n\nmsg.payload = [\n  msg.payload.name || '',\n  msg.payload.codigo || '',\n  msg.payload.email || '',\n  msg.payload.curso || 'Não disponivel',\n  msg.payload.status_ || '1', // Já validado\n  msg.payload.id_dispositivo || '',\n  msg.payload.finger_id !== undefined ? msg.payload.finger_id : null,\n  msg.payload.id_perfil !== undefined ? msg.payload.id_perfil : 1\n];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1270,
        "y": 860,
        "wires": [

        "g": "9d4878beb21615fa",
        "name": "QUERY",
        "func": "var Utilizador_Email = msg.payload.Utilizador_Email;\nvar Nome = msg.payload.Nome;\nvar area_ID = msg.payload.area_ID;\nvar ID_TipoSensor = msg.payload.ID_TipoSensor;\nvar coordenada = msg.payload.coordenada;\n\nvar ID_ValorSensor_Principal = msg.payload.ID_ValorSensor_Principal ? msg.payload.ID_ValorSensor_Principal : 'NULL';\nvar ID_ValorSensor = msg.payload.ID_ValorSensor ? msg.payload.ID_ValorSensor : 'NULL';\n\nmsg.topic = `INSERT INTO Sensor \n(Nome, area_ID, ID_TipoSensor, coordenada, ID_ValorSensor_Principal, ID_ValorSensor) \nVALUES ('${Nome}', ${area_ID}, ${ID_TipoSensor}, '${coordenada}', ${ID_ValorSensor_Principal}, ${ID_ValorSensor});`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",

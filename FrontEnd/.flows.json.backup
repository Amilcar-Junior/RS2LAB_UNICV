    {
        "id": "e462ffa72b462a7b",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "079dd86e44d9d48f",
        "name": "Buscar Sensores e Tópicos",
        "func": "msg.topic = `SELECT s.ID as Sensor_ID, v.ID as ValorSensor_ID, v.Topico \nFROM Sensor s \nJOIN ValorSensor v ON s.ID_ValorSensor = v.ID\nWHERE v.is_activatable = FALSE;`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1280,
        "y": 820,
        "wires": [
            [
                "f65a05221f1c993f",
                "4225910ac985617e"
            ]
        ]
    },
    {
        "id": "7e91648685fc02b1",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "079dd86e44d9d48f",
        "name": "Assinar Tópicos MQTT",
        "func": "var sensors = msg.payload;\nfor (var i = 0; i < sensors.length; i++) {\n    var sensor = sensors[i];\n    node.send({\n        topic: sensor.Topico,\n        sensorID: sensor.Sensor_ID,\n        valorSensorID: sensor.ValorSensor_ID,\n        action: \"subscribe\",\n    });\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1720,
        "y": 820,
        "wires": [
            [
                "b8d018092f744d92",
                "4cbfad550e67f493"
            ]
        ]
    },

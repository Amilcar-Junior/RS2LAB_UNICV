    {
        "id": "90b266c7964d5077",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "aca2614308f3370d",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    a.ID AS Area_ID, \n    a.Nome AS Area_Nome, \n    a.Localizacao AS Area_Localizacao,\n    a.ID_Grupo AS Grupo_ID,\n    g.Nome AS Grupo_Nome,\n    a.ID_Local AS Local_ID,\n    l.Nome AS Local_Nome,\n    JSON_ARRAYAGG(\n        JSON_OBJECT(\n            'Sensor_ID', s.ID,\n            'Sensor_Nome', s.Nome,\n            'TipoSensor_ID', s.ID_TipoSensor,\n            'Sensor_Coordenada', s.coordenada,\n            'TipoSensor_Nome', t.Nome,\n            'TipoSensor_Icon', t.icon\n        )\n    ) AS Sensores\nFROM \n    AreaDeAgricultura a\nLEFT JOIN \n    Sensor s ON a.ID = s.area_ID\nLEFT JOIN \n    TipoSensor t ON s.ID_TipoSensor = t.ID\nLEFT JOIN\n    GrupoUtilizadores g ON a.ID_Grupo = g.ID\nLEFT JOIN\n    Local l ON a.ID_Local = l.ID\nGROUP BY \n    a.ID, g.Nome, l.Nome;\n`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 6700,
        "wires": [
            [
                "1a3da297d578b674"
            ]
        ]
    },

    {
        "id": "524ef21b7cee7421",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "2a89c69adb724fd2",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT\n    u.ID AS Utilizador_ID,\n    u.Nome AS Utilizador_Nome,\n    u.Senha AS Utilizador_Senha,\n    u.Email AS Utilizador_Email,\n    u.isActive AS Utilizador_isActive,\n    u.Avatar AS Utilizador_Avatar,\n    t.ID AS TipoUtilizador_ID,\n    t.Nome AS TipoUtilizador_Nome,\n    JSON_ARRAYAGG(ug.ID_Grupo) AS Grupos\nFROM\n    Utilizador u\nJOIN\n    TipoUtilizador t ON u.ID_TipoUtilizador = t.ID\nJOIN\n    UtilizadorGrupo ug ON u.ID = ug.ID_Utilizador\nWHERE\n    ug.ID_Grupo = 1\n    AND u.ID IN (SELECT ID_Utilizador FROM UtilizadorGrupo WHERE ID_Grupo = 1)\nGROUP BY\n    u.ID, t.ID;\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

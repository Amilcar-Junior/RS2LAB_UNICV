    {
        "id": "1",
        "type": "http in",
        "z": "43734a494ac50a59",
        "g": "2a89c69adb724fd2",
        "name": "Send account to email",
        "url": "/rs2lab/send-account",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 1760,
        "y": 2980,
        "wires": [
            [
                "2"
            ]
        ]
    },
    {
        "id": "2",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "2a89c69adb724fd2",
        "name": "Gerar Código",
        "func": "var Utilizador_Email = msg.payload.Utilizador_Email;\nvar Utilizador_Senha = msg.payload.Utilizador_Senha;\nvar Utilizador_Nome = msg.payload.Utilizador_Nome;\n\n// Melhoria na formatação do email\nmsg.payload = `\n  <div style=\"font-family: Arial, sans-serif; color: #333;\">\n    <h2 style=\"color: #AB162B;\">Bem-vind@ à Plataforma RS2Lab, ${Utilizador_Nome}!</h2>\n    <p>Estamos felizes por tê-l@ connosco.</p>\n    <p>Aqui estão as suas credenciais para aceder à plataforma:</p>\n    <table style=\"border-collapse: collapse; width: 100%; margin-top: 10px;\">\n      <tr>\n        <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Email:</td>\n        <td style=\"padding: 8px; border: 1px solid #ddd;\">${Utilizador_Email}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Palavra-passe:</td>\n        <td style=\"padding: 8px; border: 1px solid #ddd;\">${Utilizador_Senha}</td>\n      </tr>\n    </table>\n    <p style=\"margin-top: 20px;\">Por favor, utilize essas credenciais para aceder à nossa plataforma e explorar os serviços disponíveis.</p>\n    <p style=\"color: #AB162B;\">Atenciosamente,<br>Equipe RS2Lab</p>\n  </div>\n`;\n\nmsg.to = `${Utilizador_Email}`;  // Configurando explicitamente o destinatário\nmsg.topic = `Bem-vind@ ${Utilizador_Nome} à Plataforma RS2Lab`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1960,
        "y": 2980,
        "wires": [
            [
                "3",
                "4547dc1513ce39b8",
                "0c46c345d4ad2366"
            ]
        ]
    },

    {
        "id": "5a6903702a9d65b4",
        "type": "http in",
        "z": "43734a494ac50a59",
        "g": "9e6382268e9dd573",
        "name": "login",
        "url": "/rs2lab/login",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 230,
        "y": 320,
        "wires": [
            [
                "10b80deb4d9ff607"

    {
        "id": "3aa3a63b3cc1e7d1",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "2a89c69adb724fd2",
        "name": "Gerar Código",
        "func": "var Utilizador_Email = msg.payload.Utilizador_Email;\nvar recoveryCode = msg.payload.recoveryCode;\n\nmsg.recoveryCode = `${recoveryCode}`;\nmsg.payload = `\n  <div style=\"font-family: Arial, sans-serif; color: #333;\">\n    <h2 style=\"color: #AB162B;\">Código de Recuperação</h2>\n    <p>Olá,</p>\n    <p>Você solicitou a recuperação de sua conta na plataforma RS2Lab.</p>\n    <p>Aqui está o seu código de recuperação:</p>\n    <div style=\"font-size: 24px; font-weight: bold; color: #AB162B; margin: 20px 0;\">\n      ${msg.recoveryCode}\n    </div>\n    <p>Use este código para redefinir a sua senha.</p>\n    <p style=\"margin-top: 20px;\">Se você não solicitou a recuperação da conta, por favor, ignore este e-mail.</p>\n    <p style=\"color: #AB162B;\">Atenciosamente,<br>Equipe RS2Lab</p>\n  </div>\n`;\n\nmsg.to = `${Utilizador_Email}`;\nmsg.topic = `Código de Recuperação - ${msg.recoveryCode}`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2580,
        "y": 2980,
        "wires": [

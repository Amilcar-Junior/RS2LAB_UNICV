        "type": "http in",
        "z": "43734a494ac50a59",
        "g": "2a89c69adb724fd2",
        "name": "Recovery Account",
        "url": "/rs2lab/send-recovery-code",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 2370,
        "y": 2980,

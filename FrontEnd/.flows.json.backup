    {
        "id": "974392b3ae16a155",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "079dd86e44d9d48f",
        "name": "Buscar ID do Topico",
        "func": "var topico = msg.topic;\nvar valor = msg.payload;\nmsg.topic = `SELECT ID FROM ValorSensor WHERE Topico = '${topico}' LIMIT 1;`;\nmsg.valor = valor\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2160,
        "y": 820,
        "wires": [
            [
                "200afd51e3468cd7"
            ]
        ]
    },
    {
        "id": "3b43a45864c2909b",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "079dd86e44d9d48f",
        "name": "Buscar Sensor pelo Topico",
        "func": "if (msg.payload.length > 0) {\n    var idValorSensor = msg.payload[0].ID;\n    msg.ID_Topico = idValorSensor; // Armazenar o ID do ValorSensor\n    msg.topic = `SELECT ID FROM Sensor WHERE ID_ValorSensor = ${idValorSensor} OR ID_ValorSensor_Principal = ${idValorSensor} LIMIT 1;`;\n    return msg;\n} else {\n    node.error('Nenhum ID de ValorSensor encontrado para o tópico: ' + msg.topic);\n}\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1340,
        "y": 1000,
        "wires": [
            [
                "93534a75266875b7"
            ]
        ]
    },
    {
        "id": "835e58686d07c9e5",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "079dd86e44d9d48f",
        "name": "Armazenar dados no Histórico do Sensor",
        "func": "if (msg.payload.length > 0) {\n    var idSensor = msg.payload[0].ID; // ID do Sensor\n    var valorColetado = msg.valor; // Valor coletado do MQTT\n    // Verificar se o valor coletado é um número válido\n    if (isNaN(valorColetado) || valorColetado === null) {\n        valorColetado = 0; // Definir como 0 se não for um número\n    }\n\n    // Obter a data atual no formato que o MySQL aceita: 'YYYY-MM-DD HH:MM:SS'\n    var now = new Date();\n    var timestamp = now.getFullYear() + '-' +\n        ('0' + (now.getMonth() + 1)).slice(-2) + '-' +\n        ('0' + now.getDate()).slice(-2) + ' ' +\n        ('0' + now.getHours()).slice(-2) + ':' +\n        ('0' + now.getMinutes()).slice(-2) + ':' +\n        ('0' + now.getSeconds()).slice(-2);\n\n    // Montar a query para inserir no histórico\n    msg.topic = `INSERT INTO HistoricoSensor (ID_Sensor, ValorColetado, DataHora) VALUES (${idSensor}, '${valorColetado}', '${timestamp}');`;\n    return msg;\n} else {\n    node.error('Nenhum sensor encontrado para o ID de ValorSensor: ' + msg.sensorID);\n}\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1860,
        "y": 1000,
        "wires": [
            [
                "3141c96d26558b3f",
                "0a7721de43a60ce3"
            ]
        ]
    },

        "id": "2a3b4c5d",
        "type": "function",
        "z": "a1b2c3d4e5",
        "name": "Montar URL API",
        "func": "let codigo = msg.req.query.codigo;\nif (!codigo) {\n    msg.payload = { error: \"Código de estudante não fornecido\" };\n    msg.statusCode = 400;\n    return msg;\n}\nmsg.url = `http://betaapi.unicv.cv/api-basic-v1/person/view?id=${codigo}`;\nreturn msg;",
        "outputs": 1,

        "g": "b11e1f71e8119fb5",
        "name": "function 26",
        "func": "msg.topic = `SELECT \n    p.nome AS name,\n    p.codigo,\n    p.status AS status_,\n    e.nome_edificio,\n    d.id_dispositivo,\n    pa.id_perfil,\n    pa.nome_perfil\n    FROM pessoa p\n    JOIN perfis_acesso pa ON p.id_perfil = pa.id_perfil \n    JOIN dispositivo d ON p.id_dispositivo = d.id_dispositivo\n    JOIN edificio e ON d.id_edificio = e.id_edificio\n    WHERE NOT p.id_perfil = 1;`;\nreturn msg;\n\n",

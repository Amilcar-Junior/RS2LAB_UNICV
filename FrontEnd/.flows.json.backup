    {
        "id": "db2b0f074c5a2595",
        "type": "function",
        "z": "b945a241e156bcfb",
        "g": "e23f91c6c90719a6",
        "name": "Query",
        "func": "// Validação do status_ (garante que seja '0' ou '1')\nif (msg.payload.status_ !== '0' && msg.payload.status_ !== '1') {\n    msg.payload.status_ = '0'; // Valor padrão: '0' (Inativo)\n}\n\n// Query segura com prepared statement\nmsg.topic = `\n  INSERT INTO pessoa \n    (codigo, nome, status, id_dispositivo, tagId, id_perfil) \n  VALUES (?,?, ?, ?, ?, ?)`;\n\nmsg.payload = [\n    msg.payload.codigo || '',\n    msg.payload.name || '',\n    msg.payload.status_ || '0', // Já validado\n    msg.payload.id_dispositivo || '',\n    msg.payload.tagId !== undefined ? msg.payload.tagId : null,\n    msg.payload.id_perfil || 2,\n]\n\nreturn msg;\n\n\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

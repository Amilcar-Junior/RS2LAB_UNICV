        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    s.ID, \n    s.Nome, \n    s.area_ID, \n    s.ID_TipoSensor,\n    s.coordenada,\n    s.ID_ValorSensor,\n    a.Nome AS Area_Nome,\n    a.ID_Grupo AS Grupo_ID,\n    g.Nome AS Grupo_Nome,\n    t.Nome AS TipoSensor_Nome,\n    t.icon AS TipoSensor_Icon,\n    v.Valor AS ValorSensor_Valor,\n    v.Data_Hora AS ValorSensor_Data_Hora,\n    v.Topico AS ValorSensor_Topico,\n    v.is_activatable AS ValorSensor_IsActivable\nFROM \n    Sensor s\nLEFT JOIN \n    AreaDeAgricultura a ON s.area_ID = a.ID\nLEFT JOIN \n    GrupoUtilizadores g ON a.ID_Grupo = g.ID\nLEFT JOIN \n    TipoSensor t ON s.ID_TipoSensor = t.ID\nLEFT JOIN\n    ValorSensor v ON s.ID_ValorSensor = v.ID;\n`;\nreturn msg;\n",

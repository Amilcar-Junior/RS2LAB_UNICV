    {
        "id": "5fb0c54dd27a05dc",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "9e6382268e9dd573",
        "name": "Query",
        "func": "var Utilizador_Email = 'amilcarjunior11@gmail.com';\nvar Utilizador_Senha = 'amilcarjunior11';\n\nmsg.topic = `SELECT\n    u.ID AS Utilizador_ID,\n    u.Nome AS Utilizador_Nome,\n    u.Senha AS Utilizador_Senha,\n    u.Email AS Utilizador_Email,\n    u.isActive AS Utilizador_isActive,\n    u.image AS Utilizador_image,\n    t.ID AS TipoUtilizador_ID,\n    t.Nome AS TipoUtilizador_Nome,\n    JSON_ARRAYAGG(\n        JSON_OBJECT(\n            'ID', g.ID,\n            'Nome', g.Nome\n        )\n    ) AS Grupos\nFROM\n    Utilizador u\nLEFT JOIN\n    TipoUtilizador t ON u.ID_TipoUtilizador = t.ID\nLEFT JOIN\n    UtilizadorGrupo ug ON u.ID = ug.ID_Utilizador\nLEFT JOIN\n    GrupoUtilizadores g ON ug.ID_Grupo = g.ID\nWHERE\n    u.Email = '${Utilizador_Email}' \n    AND u.Senha = SHA2('${Utilizador_Senha}', 256)\nGROUP BY\n    u.ID, t.ID;\n`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 260,
        "wires": [
            [
                "bf867f6535aceded"
            ]
        ]
    },
    {
        "id": "430812fd9f9d8c55",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "9e6382268e9dd573",
        "name": "UpdateUser",
        "func": "\nvar updatedDetails = msg.payload;\n\n// Atualiza os detalhes do utilizador no fluxo\nvar session = flow.get(msg.token);\nif (session) {\n    session.user.Utilizador_Nome = updatedDetails.Utilizador_Nome;\n    session.user.Utilizador_Email = updatedDetails.Utilizador_Email;\n    session.user.Utilizador_image = updatedDetails.Utilizador_image;\n    // Atualize outros campos conforme necessário\n\n    flow.set(msg.token, session);\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,

    {
        "id": "d2d9c1e86cd5b597",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "9d4878beb21615fa",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    s.ID, \n    s.Nome, \n    s.area_ID, \n    s.ID_TipoSensor,\n    s.coordenada,\n    s.ID_ValorSensor,\n    a.Nome AS Area_Nome,\n    t.Nome AS TipoSensor_Nome,\n    t.icon AS TipoSensor_Icon,\n    v.Valor AS ValorSensor_Valor,\n    v.Data_Hora AS ValorSensor_Data_Hora,\n    v.Topico AS ValorSensor_Topico\nFROM \n    Sensor s\nLEFT JOIN \n    AreaDeAgricultura a ON s.area_ID = a.ID\nLEFT JOIN \n    TipoSensor t ON s.ID_TipoSensor = t.ID\nLEFT JOIN\n    ValorSensor v ON s.ID_ValorSensor = v.ID\nWHERE \n    s.ID = ${msg.req.params.ID};\n`;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 6000,
        "wires": [
            [
                "09233203c96c6b18"
            ]
        ]
    },

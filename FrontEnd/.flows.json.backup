    {
        "id": "3a9343d76bb40d2f",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "9e6382268e9dd573",
        "name": "Logout",
        "func": "flow.set(msg.token, undefined);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,

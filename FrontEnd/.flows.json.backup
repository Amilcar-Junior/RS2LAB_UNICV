        "func": "// msg.payload.status_ = msg.payload.status_ ? 1 : 0;\n// Substitua a query por:\nconst query = `\n  UPDATE pessoa \n  SET nome = ?, status = ?, id_dispositivo = ?, id_perfil = ?\n  WHERE codigo = ?\n`;\nconst values = [\n  msg.payload.name,\n  msg.payload.status_,\n  msg.payload.id_dispositivo,\n  msg.payload.id_perfil,\n  msg.payload.codigo\n];\n\nmsg.topic = query;\nmsg.payload = values;\n\nreturn msg;",

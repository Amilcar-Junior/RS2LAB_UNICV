    {
        "id": "196ff61c660946b5",
        "type": "function",
        "z": "43734a494ac50a59",
        "g": "0c97019c13d4f365",
        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    ug.ID, \n    u.ID AS Utilizador_ID, \n    u.Nome AS Utilizador_Nome, \n    g.ID AS Grupo_ID, \n    g.Nome AS Grupo_Nome\nFROM \n    UtilizadorGrupo ug\nLEFT JOIN \n    Utilizador u ON ug.ID_Utilizador = u.ID\nLEFT JOIN \n    GrupoUtilizadores g ON ug.ID_Grupo = g.ID\nWHERE\nug.ID_Utilizador = ${msg.req.params.ID};`;\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

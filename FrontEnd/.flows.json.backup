        "g": "a6adededcdd25826",
        "name": "UpdateUser",
        "func": "\nvar updatedDetails = msg.payload;\n\n// Atualiza os detalhes do utilizador no fluxo\nvar session = flow.get(msg.token);\nif (session) {\n    session.user.Utilizador_Nome = updatedDetails.Utilizador_Nome;\n    session.user.Utilizador_Email = updatedDetails.Utilizador_Email;\n    session.user.Utilizador_image = updatedDetails.Utilizador_image;\n    // Atualize outros campos conforme necessário\n\n    flow.set(msg.token, session);\n}\nreturn msg;\n",

        "name": "QUERY",
        "func": "msg.topic = `\nSELECT \n    s.ID, \n    s.Nome, \n    s.area_ID, \n    s.ID_TipoSensor,\n    s.coordenada,\n    s.ID_ValorSensor,\n    a.Nome AS Area_Nome,\n    t.Nome AS TipoSensor_Nome,\n    t.icon AS TipoSensor_Icon,\n    v.Valor AS ValorSensor_Valor,\n    v.Data_Hora AS ValorSensor_Data_Hora,\n    v.is_activatable AS ValorSensor_IsActivable,\n    v.Topico AS ValorSensor_Topico,\n        p.Valor AS ValorSensor_Principal_Valor,\n    p.Valor AS ValorSensor_Principal_Valor,\n    p.Data_Hora AS ValorSensor_Principal_Data_Hora,\n    p.Topico AS ValorSensor_Principal_Topico,\n    p.is_activatable AS ValorSensor_Principal_IsActivable\nFROM \n    Sensor s\nLEFT JOIN \n    AreaDeAgricultura a ON s.area_ID = a.ID\nLEFT JOIN \n    TipoSensor t ON s.ID_TipoSensor = t.ID\nLEFT JOIN\n    ValorSensor p ON s.ID_ValorSensor_Principal = p.ID\nLEFT JOIN\n    ValorSensor v ON s.ID_ValorSensor = v.ID\nWHERE \n    s.ID = ${msg.req.params.ID};\n`;\nreturn msg;\n",

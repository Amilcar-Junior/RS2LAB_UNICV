        "id": "6a7b8c9d",
        "type": "http response",
        "z": "a1b2c3d4e5",
        "name": "Retornar Resposta",
        "statusCode": "",
        "headers": {},
        "x": 1100,
        "y": 100,
        "wires": []
    },
    {
        "id": "645294b2271d619a",
        "type": "function",
        "z": "a1b2c3d4e5",
        "name": "Validar e Atualizar",
        "func": "// Validação do id_dispositivo\nconst checkQuery = \"SELECT id_dispositivo FROM dispositivo WHERE id_dispositivo = '\" + msg.payload.id_dispositivo + \"';\";\n\n// Executar verificação\nglobal.get(\"mysql\").query(checkQuery, (err, result) => {\n    if (err) {\n        node.error(err);\n        return;\n    }\n\n    if (result.length === 0) {\n        msg.payload = { error: \"Dispositivo inválido\" };\n        node.send(msg);\n        return;\n    }\n\n    // Atualização segura\n    const updateQuery = \"UPDATE pessoa SET status = '\" + msg.payload.status_ + \"', id_dispositivo = '\" + msg.payload.id_dispositivo + \"' WHERE codigo = '\" + msg.payload.codigo + \"';\";\n\n    global.get(\"mysql\").query(updateQuery, (err, result) => {\n        msg.payload = err ? { error: err.message } : result;\n        node.send(msg);\n    });\n});",
        "outputs": 1,
        "x": 650,
        "y": 340,
        "wires": [
            []
        ]
    }
]
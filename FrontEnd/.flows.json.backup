        "type": "function",
        "z": "b945a241e156bcfb",
        "g": "e0914e4a4497fb15",
        "name": "function 17",
        "func": "msg.topic = `SELECT \n  p.nome AS name,\n  a.data_hora,\n  e.nome_edificio,\n  a.tipo AS logg_info\n  FROM acessos a\n  JOIN pessoa p ON a.codigo = p.codigo\n  JOIN dispositivo d ON a.id_dispositivo = d.id_dispositivo\n  JOIN edificio e ON d.id_edificio = e.id_edificio\n  ORDER BY a.data_hora DESC;\n`;\n\nreturn msg;\n",
